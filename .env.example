# Salin menjadi `.env` untuk pengembangan lokal. Jangan commit `.env`.
NODE_ENV=development
PORT=3000

# PostgreSQL dari `docker compose up`. Bila port 5432 sudah dipakai
# PostgreSQL lokal, set POSTGRES_PORT=5433 dan sesuaikan port di DATABASE_URL.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://azetta:azetta@localhost:5432/azetta?schema=public

# Better Auth
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
COOKIE_DOMAIN=
IP_HASH_SALT=dev-only-ip-hash-salt

# Cloudflare R2 (nilai placeholder untuk lokal)
R2_ACCOUNT_ID=dev-account-id
R2_ACCESS_KEY_ID=dev-access-key-id
R2_SECRET_ACCESS_KEY=dev-secret-access-key
R2_BUCKET=azetta-dev-media
R2_PUBLIC_BASE_URL=http://localhost:9000/azetta-dev-media

# Cloudflare Turnstile — kunci uji resmi, selalu lolos
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Email (lokal: lihat Mailpit di http://localhost:8025)
RESEND_API_KEY=re_dev_placeholder
MAIL_FROM=no-reply@azetta.test
SALES_NOTIFY_EMAIL=sales@azetta.test
RESEND_WEBHOOK_SECRET=

PUBLIC_API_BASE_URL=http://localhost:3000

# Opsional
SENTRY_DSN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PURGE_TOKEN=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=


ADMINER_PORT=