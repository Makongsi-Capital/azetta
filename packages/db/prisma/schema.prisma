generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator json {
  provider     = "prisma-json-types-generator"
  namespace    = "PrismaJson"
  allowAny     = false
  clientOutput = "../src/generated/prisma"
}

generator prismabox {
  provider                    = "prismabox"
  typeboxImportDependencyName = "elysia"
  typeboxImportVariableName   = "t"
  inputModel                  = true
  output                      = "../src/generated/prismabox"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Better Auth
// ============================================================

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // admin plugin
  role       String    @default("customer")
  banned     Boolean   @default(false)
  banReason  String?
  banExpires DateTime?

  // profil aplikasi
  phone       String?
  whatsapp    String?
  city        String?
  company     String?
  lastLoginAt DateTime?

  sessions      Session[]
  accounts      Account[]
  createdLeads  Lead[]           @relation("LeadCreatedBy")
  assignedLeads Lead[]           @relation("LeadAssignee")
  activities    LeadActivity[]
  attachments   LeadAttachment[] @relation("AttachmentUploader")
  articles      Article[]        @relation("ArticleAuthor")
  projects      Project[]        @relation("ProjectAuthor")
  auditLogs     AuditLog[]
  settings      SiteSetting[]    @relation("SettingUpdatedBy")

  deletionRequests        AccountDeletionRequest[] @relation("DeletionRequestedBy")
  handledDeletionRequests AccountDeletionRequest[] @relation("DeletionRequestHandledBy")
  medias                  Media[]

  @@index([role])
  @@map("user")
}

model Session {
  id             String   @id
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ============================================================
// Katalog unit
// ============================================================

enum UnitPublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum UnitSalesStatus {
  AVAILABLE
  INDENT
  SOLD
}

enum UnitMediaKind {
  RENDER
  FLOOR_PLAN
  PHOTO
  SITE_PLAN
  VIDEO
}

model Unit {
  id          Int     @id @default(autoincrement())
  slug        String  @unique
  unitCode    String
  typeName    String
  title       String
  subtitle    String?
  /// HTML tersanitasi (Tiptap)
  description String  @db.Text

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  floors         Int @default(1)
  bedrooms       Int @default(0)
  bathrooms      Int @default(0)
  carports       Int @default(0)
  buildingAreaM2 Int
  landAreaM2     Int

  priceFrom BigInt?
  /// Internal saja — tidak pernah dikirim ke API publik (Q8)
  estimatedBuildCostMin BigInt?
  estimatedBuildCostMax BigInt?

  publishStatus  UnitPublishStatus @default(DRAFT)
  salesStatus    UnitSalesStatus   @default(AVAILABLE)
  featured       Boolean           @default(false)
  viewCount      Int               @default(0)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  media UnitMedia[]
  leads Lead[]

  @@unique([projectId, unitCode])
  @@index([publishStatus, publishedAt])
  @@index([projectId, publishStatus])
  @@index([salesStatus, publishStatus])
  @@index([typeName])
  @@index([deletedAt])
  @@map("unit")
}

model UnitMedia {
  id         Int           @id @default(autoincrement())
  unitId     Int
  kind       UnitMediaKind @default(RENDER)
  storageKey String
  url        String
  alt        String?
  width      Int?
  height     Int?
  sortOrder  Int           @default(0)
  isCover    Boolean       @default(false)
  createdAt  DateTime      @default(now())

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId, sortOrder])
  @@map("unit_media")
}

// ============================================================
// Lead & CRM
// ============================================================

enum LeadType {
  BUY_UNIT
  LAND_OFFER
  GENERAL
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
  SPAM
}

enum LeadPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum LeadSource {
  WEBSITE
  ORGANIC_SEARCH
  SOCIAL
  ADS
  REFERRAL
  WHATSAPP
  EVENT
  OTHER
}

enum ActivityType {
  NOTE
  STATUS_CHANGE
  ASSIGNMENT
  CALL
  WHATSAPP
  EMAIL
  MEETING
  SYSTEM
}

enum AttachmentKind {
  LAND_PHOTO
  DOCUMENT
  OTHER
}

enum OwnershipStatus {
  SHM
  SHGB
  AJB
  GIRIK
  LETTER_C
  OTHER
}

enum ExpectedScheme {
  BAGI_HASIL
  SEWA
  JUAL
  BELUM_TAHU
}

enum StartTimeline {
  IMMEDIATE
  M3_6
  M6_12
  OVER_12
  UNKNOWN
}

model Lead {
  id        String       @id @default(uuid(7)) @db.Uuid
  reference String       @unique
  type      LeadType
  status    LeadStatus   @default(NEW)
  priority  LeadPriority @default(NORMAL)

  name            String
  phone           String
  phoneNormalized String
  email           String?
  city            String?
  message         String? @db.Text

  unitId Int?
  unit   Unit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  source      LeadSource @default(WEBSITE)
  landingPath String?
  referrerUrl String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  ipHash      String?
  userAgent   String?

  userId       String?
  user         User?   @relation("LeadCreatedBy", fields: [userId], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   User?   @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  estimatedValue        BigInt?
  lostReason            String?
  firstContactedAt      DateTime?
  lastContactedAt       DateTime?
  nextFollowUpAt        DateTime?
  closedAt              DateTime?
  spamScore             Int       @default(0)
  idempotencyKey        String?   @unique
  customerNote          String?   @db.Text
  customerNoteUpdatedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  landSubmission LandSubmission?
  activities     LeadActivity[]
  attachments    LeadAttachment[]

  @@index([status, createdAt])
  @@index([type, status])
  @@index([assignedToId, status])
  @@index([phoneNormalized])
  @@index([createdAt])
  @@index([unitId])
  @@index([deletedAt])
  @@map("lead")
}

model LandSubmission {
  id      Int    @id @default(autoincrement())
  leadId  String @unique @db.Uuid
  address String

  province String
  city     String
  district String?

  areaM2              Int
  frontageM           Int?
  ownershipStatus     OwnershipStatus
  certificateOnBehalf String?
  zoning              String?
  currentUse          String?
  roadAccess          String?
  estimatedValue      BigInt?
  expectedScheme      ExpectedScheme
  startTimeline       StartTimeline?
  notes               String?         @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([province, city])
  @@map("land_submission")
}

model LeadActivity {
  id     Int          @id @default(autoincrement())
  leadId String       @db.Uuid
  type   ActivityType
  body   String?      @db.Text
  /// [LeadActivityMeta]
  meta   Json?

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([actorId, createdAt])
  @@map("lead_activity")
}

model LeadAttachment {
  id         Int            @id @default(autoincrement())
  leadId     String         @db.Uuid
  kind       AttachmentKind @default(LAND_PHOTO)
  fileName   String
  storageKey String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime       @default(now())

  uploadedById String?
  uploadedBy   User?   @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_attachment")
}

// ============================================================
// Portofolio proyek
// ============================================================

enum ProjectStatus {
  PLANNED
  ONGOING
  COMPLETED
}

model Project {
  id          Int     @id @default(autoincrement())
  slug        String  @unique
  title       String
  summary     String?
  /// HTML tersanitasi (Tiptap)
  description String? @db.Text

  location String
  city     String
  province String

  status        ProjectStatus @default(ONGOING)
  yearStarted   Int?
  yearCompleted Int?
  landAreaM2    Int?
  unitCount     Int?

  coverImageUrl String?
  galleryUrls   String[]
  isPublished   Boolean  @default(false)
  sortOrder     Int      @default(0)

  seoTitle       String?
  seoDescription String?

  createdById String?
  createdBy   User?   @relation("ProjectAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  units Unit[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isPublished, sortOrder])
  @@index([status, yearCompleted])
  @@index([deletedAt])
  @@map("project")
}

// ============================================================
// Konten
// ============================================================

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Article {
  id             Int           @id @default(autoincrement())
  slug           String        @unique
  title          String
  excerpt        String?
  /// HTML tersanitasi (Tiptap)
  content        String        @db.Text
  coverImageUrl  String?
  status         ArticleStatus @default(DRAFT)
  publishedAt    DateTime?
  readingMinutes Int?
  tags           String[]
  viewCount      Int           @default(0)
  seoTitle       String?
  seoDescription String?

  authorId String?
  author   User?   @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, publishedAt])
  @@index([deletedAt])
  @@map("article")
}

model Faq {
  id        Int     @id @default(autoincrement())
  question  String
  answer    String  @db.Text
  category  String  @default("umum")
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, sortOrder])
  @@map("faq")
}

model Testimonial {
  id          Int     @id @default(autoincrement())
  name        String
  role        String?
  projectName String?
  quote       String  @db.Text
  avatarUrl   String?
  isPublished Boolean @default(false)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonial")
}

model SiteSetting {
  key   String @id
  /// [SiteSettingValue]
  value Json

  updatedById String?
  updatedBy   User?   @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt

  @@map("site_setting")
}

// ============================================================
// Operasional
// ============================================================

model AuditLog {
  id         Int     @id @default(autoincrement())
  action     String
  entityType String
  entityId   String
  /// [AuditSnapshot]
  before     Json?
  /// [AuditSnapshot]
  after      Json?
  ipHash     String?

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_log")
}

model FunnelEvent {
  id        Int      @id @default(autoincrement())
  name      String
  path      String
  unitId    Int?
  leadId    String?  @db.Uuid
  sessionId String?
  /// [FunnelProps]
  props     Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([unitId])
  @@index([leadId])
  @@map("funnel_event")
}

enum DeletionRequestStatus {
  PENDING
  COMPLETED
  REJECTED
}

model AccountDeletionRequest {
  id     String                @id @default(nanoid())
  userId String
  reason String?
  status DeletionRequestStatus @default(PENDING)

  requestedAt DateTime  @default(now())
  handledAt   DateTime?
  handledById String?
  note        String?

  user      User  @relation("DeletionRequestedBy", fields: [userId], references: [id], onDelete: Cascade)
  handledBy User? @relation("DeletionRequestHandledBy", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, requestedAt])
  @@map("account_deletion_request")
}

model Media {
  id            String  @id @default(nanoid(16))
  key           String  @unique
  url           String
  mime          String
  size          Int
  folder        String
  original_name String?
  uploaded_by   String?

  created_at DateTime @default(now())

  uploader User? @relation(fields: [uploaded_by], references: [id], onDelete: SetNull)

  @@index([folder])
  @@index([created_at])
  @@map("media")
}
